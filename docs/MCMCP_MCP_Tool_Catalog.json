    {
      "name": "agent_start_action",
      "title": "Start MCMCP Action",
      "description": "Queues one validated and statically bounded Action DSL v1 program after the in-game MCP operation button is enabled.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "$defs": {
          "resourceLocation": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
            "maxLength": 128
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension": {"$ref": "#/$defs/resourceLocation"},
              "x": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
              "y": {"type": "integer", "minimum": -2048, "maximum": 2048},
              "z": {"type": "integer", "minimum": -30000000, "maximum": 30000000}
            },
            "required": ["dimension", "x", "y", "z"]
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "comparison": {
            "enum": ["lt", "lte", "eq", "gte", "gt"]
          },
          "numericPredicate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {"enum": ["health", "hunger", "air"]},
              "comparison": {"$ref": "#/$defs/comparison"},
              "value": {"type": "number", "minimum": -2048, "maximum": 2048}
            },
            "required": ["field", "comparison", "value"]
          },
          "booleanPredicate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {"enum": ["on_fire", "submerged"]},
              "comparison": {"const": "eq"},
              "value": {"type": "boolean"}
            },
            "required": ["field", "comparison", "value"]
          },
          "inventoryPredicate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {"const": "inventory_count"},
              "item": {"$ref": "#/$defs/resourceLocation"},
              "comparison": {"$ref": "#/$defs/comparison"},
              "value": {"type": "integer", "minimum": 0, "maximum": 2147483647}
            },
            "required": ["field", "item", "comparison", "value"]
          },
          "statusPredicate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {"const": "has_status_effect"},
              "effect": {"$ref": "#/$defs/resourceLocation"},
              "comparison": {"const": "eq"},
              "value": {"type": "boolean"}
            },
            "required": ["field", "effect", "comparison", "value"]
          },
          "atomicPredicate": {
            "oneOf": [
              {"$ref": "#/$defs/numericPredicate"},
              {"$ref": "#/$defs/booleanPredicate"},
              {"$ref": "#/$defs/inventoryPredicate"},
              {"$ref": "#/$defs/statusPredicate"}
            ]
          },
          "predicate": {
            "oneOf": [
              {"$ref": "#/$defs/atomicPredicate"},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "all": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {"$ref": "#/$defs/atomicPredicate"}
                  }
                },
                "required": ["all"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "any": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {"$ref": "#/$defs/atomicPredicate"}
                  }
                },
                "required": ["any"]
              }
            ]
          },
          "navigateNode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "op": {"const": "navigate_to_known"},
              "target": {"$ref": "#/$defs/position"},
              "tolerance": {"type": "number", "minimum": 0.1, "maximum": 1.5}
            },
            "required": ["id", "op", "target", "tolerance"]
          },
          "faceNode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "op": {"const": "face_known_position"},
              "target": {"$ref": "#/$defs/position"}
            },
            "required": ["id", "op", "target"]
          },
          "breakNode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "op": {"const": "break_known_face"},
              "target": {"$ref": "#/$defs/position"},
              "face": {"enum": ["down", "up", "north", "south", "west", "east"]},
              "expected_block": {"enum": ["minecraft:oak_log", "minecraft:birch_log"]},
              "tool_item": {
                "enum": [
                  "minecraft:wooden_axe", "minecraft:stone_axe", "minecraft:copper_axe",
                  "minecraft:iron_axe", "minecraft:golden_axe", "minecraft:diamond_axe",
                  "minecraft:netherite_axe"
                ]
              }
            },
            "required": ["id", "op", "target", "face", "expected_block", "tool_item"]
          },
          "waitNode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "op": {"const": "wait_ticks"},
              "ticks": {"type": "integer", "minimum": 1, "maximum": 200}
            },
            "required": ["id", "op", "ticks"]
          },
          "ifNode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "op": {"const": "if"},
              "condition": {"$ref": "#/$defs/predicate"},
              "then": {
                "type": "array",
                "maxItems": 16,
