    {
      "name": "agent_get_action",
      "title": "Get MCMCP Action",
      "description": "Returns bounded progress and a policy-filtered trace for one explicit action handle.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": ["action_id"]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {"const": 1},
          "action_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "state": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": {"enum": ["queued", "executing", "replanning", "recovering", "finished"]},
              "current_node_id": {
                "type": ["string", "null"],
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "executed_nodes": {"type": "integer", "minimum": 0, "maximum": 256},
              "total_node_upper_bound": {"type": "integer", "minimum": 1, "maximum": 256},
              "distance_travelled": {"type": "number", "minimum": 0, "maximum": 48},
              "camera_degrees": {"type": "number", "minimum": 0, "maximum": 720},
              "interactions": {"type": "integer", "minimum": 0, "maximum": 8},
              "blocks_broken": {"type": "integer", "minimum": 0, "maximum": 12},
              "blocks_placed": {"type": "integer", "minimum": 0, "maximum": 8},
              "ticks": {"type": "integer", "minimum": 0, "maximum": 800}
            },
            "required": ["phase", "current_node_id", "executed_nodes", "total_node_upper_bound", "distance_travelled", "camera_degrees", "interactions", "blocks_broken", "blocks_placed", "ticks"]
          },
          "failure": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "enum": [
                      "CANCELLED_BY_CLIENT",
                      "USER_DISABLED",
                      "EMERGENCY_STOP",
                      "BUDGET_EXCEEDED",
                      "PATH_BLOCKED",
                      "WORLD_CHANGED",
                      "SAFETY_RECOVERED",
                      "RECOVERY_EXHAUSTED",
                      "SERVER_DENIED_OR_DESYNC",
                      "PREDICATE_UNAVAILABLE",
                      "CAPABILITY_DENIED",
                      "INTERNAL_ERROR"
                    ]
                  },
                  "recoverable": {"type": "boolean"},
                  "evidence": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {"type": "string", "maxLength": 128}
                  }
                },
                "required": ["code", "recoverable", "evidence"]
              }
            ]
          },
          "trace": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tick": {"type": "integer", "minimum": 0, "maximum": 800},
                "event": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64},
                "detail": {"type": "string", "maxLength": 256}
              },
              "required": ["tick", "event", "detail"]
            }
          }
        },
        "required": ["schema_version", "action_id", "state", "progress", "failure", "trace"]
      }
    },
    {
      "name": "agent_cancel_action",
      "title": "Cancel MCMCP Action",
      "description": "Idempotently requests cancellation of one explicit action handle.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": ["action_id"]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {"const": 1},
          "action_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "cancel_requested": {"type": "boolean"},
          "state_at_request": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]}
        },
        "required": ["schema_version", "action_id", "cancel_requested", "state_at_request"]
      }
    }
  ]
