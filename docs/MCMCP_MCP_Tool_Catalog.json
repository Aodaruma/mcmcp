    {
      "name": "agent_get_state",
      "title": "Get MCMCP State",
      "description": "Returns the latest immutable, policy-filtered client state and the latest observation-frame summary. It never scans hidden world data.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {"const": 1},
          "control": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {"enum": ["off", "ready", "agent", "recovering"]},
              "ready_expires_at": {
                "type": ["string", "null"],
                "format": "date-time",
                "description": "Schema v1 compatibility field; always null because READY does not expire"
              },
              "game_paused": {"type": "boolean"}
            },
            "required": ["mode", "ready_expires_at", "game_paused"]
          },
          "world": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dimension": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                    "maxLength": 128
                  },
                  "client_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                  "world_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {"type": "number", "minimum": -30000000, "maximum": 30000000},
                      "y": {"type": "number", "minimum": -2048, "maximum": 2048},
                      "z": {"type": "number", "minimum": -30000000, "maximum": 30000000}
                    },
                    "required": ["x", "y", "z"]
                  },
                  "yaw": {"type": "number", "minimum": -180, "maximum": 180},
                  "pitch": {"type": "number", "minimum": -90, "maximum": 90},
                  "health": {"type": "number", "minimum": 0, "maximum": 2048},
                  "absorption": {"type": "number", "minimum": 0, "maximum": 2048},
                  "hunger": {"type": "integer", "minimum": 0, "maximum": 20},
                  "air": {"type": "integer", "minimum": -2048, "maximum": 2048},
                  "max_air": {"type": "integer", "minimum": 1, "maximum": 2048},
                  "on_fire": {"type": "boolean"},
                  "submerged": {"type": "boolean"},
                  "status_effects": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                      "maxLength": 128
                    }
                  }
                },
                "required": ["dimension", "client_tick", "world_revision", "position", "yaw", "pitch", "health", "absorption", "hunger", "air", "max_air", "on_fire", "submerged", "status_effects"]
              }
            ]
          },
          "inventory": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                  "maxLength": 128
                },
                "count": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              },
              "required": ["item", "count"]
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile": {"const": "survival_omnidirectional"},
              "multiplayer_enabled": {"type": "boolean"},
              "max_duration_ms": {"const": 30000},
              "max_ticks": {"const": 600},
              "max_distance_blocks": {"const": 32},
              "max_camera_degrees": {"const": 360},
              "max_blocks_broken": {"const": 8},
              "omnidirectional_visual_radius_blocks": {"type": "number", "minimum": 1, "maximum": 32},
              "local_observation_radius_blocks": {"const": 4},
              "omnidirectional_direction_count": {"const": 2048},
              "omnidirectional_rays_per_tick": {"type": "integer", "minimum": 64, "maximum": 512},
              "max_recent_sound_clues": {"const": 32},
              "sound_clue_ttl_ticks": {"const": 600},
              "action_dsl": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "version": {"const": 1},
                  "max_ast_depth": {"const": 4},
                  "max_source_nodes": {"const": 64},
                  "max_executed_nodes": {"const": 256},
                  "max_repeat_count": {"const": 16},
                  "allowed_capabilities": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {"enum": ["movement", "camera", "block_break"]}
                  }
                },
                "required": ["version", "max_ast_depth", "max_source_nodes", "max_executed_nodes", "max_repeat_count", "allowed_capabilities"]
              }
            },
            "required": ["profile", "multiplayer_enabled", "max_duration_ms", "max_ticks", "max_distance_blocks", "max_camera_degrees", "max_blocks_broken", "omnidirectional_visual_radius_blocks", "local_observation_radius_blocks", "omnidirectional_direction_count", "omnidirectional_rays_per_tick", "max_recent_sound_clues", "sound_clue_ttl_ticks", "action_dsl"]
          },
          "observation": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {"const": "omnidirectional_local"},
                  "latest_frame_id": {
                    "type": "string",
                    "pattern": "^obs-[0-9a-f]{16}$"
                  },
                  "configured_visual_radius_blocks": {"type": "number", "minimum": 1, "maximum": 32},
                  "near_volume_radius_blocks": {"const": 4},
                  "full_azimuth": {"const": true},
                  "full_elevation": {"const": true},
                  "sampling_coverage": {"const": 1},
                  "oldest_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                  "newest_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                  "camera_motion_generated": {"const": false},
                  "record_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "visible_surface": {"type": "integer", "minimum": 0},
                      "visible_entity": {"type": "integer", "minimum": 0},
                      "traversability": {"type": "integer", "minimum": 0},
                      "hazard": {"type": "integer", "minimum": 0},
                      "unknown_boundary": {"type": "integer", "minimum": 0},
                      "sound_clue": {"type": "integer", "minimum": 0, "maximum": 32}
                    },
                    "required": ["visible_surface", "visible_entity", "traversability", "hazard", "unknown_boundary", "sound_clue"]
                  },
                  "visible_entities_truncated": {"type": "boolean"},
                  "recent_sound_clues_truncated": {"type": "boolean"}
                },
                "required": ["mode", "latest_frame_id", "configured_visual_radius_blocks", "near_volume_radius_blocks", "full_azimuth", "full_elevation", "sampling_coverage", "oldest_tick", "newest_tick", "camera_motion_generated", "record_counts", "visible_entities_truncated", "recent_sound_clues_truncated"]
              }
            ]
          },
          "action": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "action_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "state": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
                  "end_reason": {
                    "type": ["string", "null"],
                    "maxLength": 64
                  }
                },
                "required": ["action_id", "state", "end_reason"]
              }
            ]
          }
        },
        "required": ["schema_version", "control", "world", "inventory", "policy", "observation", "action"]
      }
    },
    {
      "name": "agent_get_observation",
