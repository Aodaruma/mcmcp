              "position": {"$ref": "#/$defs/worldPosition"},
              "severity": {"enum": ["caution", "urgent", "unknown"]},
              "observer_position": {"$ref": "#/$defs/worldPosition"},
              "observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "world_revision": {"$ref": "#/$defs/worldRevision"},
              "provenance": {"enum": ["LOCAL_VOLUME", "CONTACT"]}
            },
            "required": ["kind", "hazard_type", "position", "severity", "observer_position", "observed_tick", "world_revision", "provenance"]
          },
          "unknownBoundary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {"const": "unknown_boundary"},
              "position": {"$ref": "#/$defs/worldPosition"},
              "reason": {"enum": ["unloaded", "opaque_occlusion", "ambiguous_render", "radius_limit", "fog_limit"]},
              "eye_origin": {"$ref": "#/$defs/worldPosition"},
              "observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "world_revision": {"$ref": "#/$defs/worldRevision"}
            },
            "required": ["kind", "position", "reason", "eye_origin", "observed_tick", "world_revision"]
          },
          "soundClue": {
            "type": "object",
