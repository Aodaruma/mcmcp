            "required": ["kind", "sound_event", "category", "position", "first_observed_tick", "last_observed_tick", "age_ticks", "occurrences", "entity_hint", "world_revision", "provenance"]
          }
        },
        "properties": {
          "schema_version": {"const": 1},
          "frame_id": {
            "type": "string",
            "pattern": "^obs-[0-9a-f]{16}$"
          },
          "frame_completed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "visible_entities_truncated": {"type": "boolean"},
