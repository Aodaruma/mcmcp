              "eye_origin": {"$ref": "#/$defs/worldPosition"},
              "observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "world_revision": {"$ref": "#/$defs/worldRevision"},
              "provenance": {"const": "OMNIDIRECTIONAL_VISUAL"}
            },
            "required": ["kind", "position", "face", "block", "shape_class", "eye_origin", "observed_tick", "world_revision", "provenance"]
          },
          "visibleEntity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {"const": "visible_entity"},
