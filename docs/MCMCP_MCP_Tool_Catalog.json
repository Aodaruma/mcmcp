              "position": {"$ref": "#/$defs/worldPosition"},
              "first_observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "last_observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "age_ticks": {"type": "integer", "minimum": 0, "maximum": 600},
              "occurrences": {"type": "integer", "minimum": 1, "maximum": 2147483647},
