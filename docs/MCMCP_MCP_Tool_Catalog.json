              "y": {"type": "integer", "minimum": -2048, "maximum": 2048},
              "z": {"type": "integer", "minimum": -30000000, "maximum": 30000000}
            },
            "required": ["dimension", "x", "y", "z"]
          },
          "vector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {"type": "number", "minimum": -128, "maximum": 128},
              "y": {"type": "number", "minimum": -128, "maximum": 128},
              "z": {"type": "number", "minimum": -128, "maximum": 128}
            },
            "required": ["x", "y", "z"]
          },
          "worldRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "aabb": {
            "type": "object",
