            "properties": {
              "min_x": {"type": "number", "minimum": -30000002, "maximum": 30000002},
              "min_y": {"type": "number", "minimum": -2050, "maximum": 2050},
              "min_z": {"type": "number", "minimum": -30000002, "maximum": 30000002},
              "max_x": {"type": "number", "minimum": -30000002, "maximum": 30000002},
              "max_y": {"type": "number", "minimum": -2050, "maximum": 2050},
              "max_z": {"type": "number", "minimum": -30000002, "maximum": 30000002}
            },
            "required": ["min_x", "min_y", "min_z", "max_x", "max_y", "max_z"]
