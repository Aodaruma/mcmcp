              "position": {"$ref": "#/$defs/worldPosition"},
              "velocity": {"$ref": "#/$defs/vector"},
              "aabb": {"$ref": "#/$defs/aabb"},
              "hazard_class": {"enum": ["passive", "neutral", "hostile", "player", "projectile", "unknown"]},
              "eye_origin": {"$ref": "#/$defs/worldPosition"},
              "observed_tick": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              "world_revision": {"$ref": "#/$defs/worldRevision"},
              "provenance": {"const": "OMNIDIRECTIONAL_VISUAL"}
            },
            "required": ["kind", "entity_type", "position", "velocity", "aabb", "hazard_class", "eye_origin", "observed_tick", "world_revision", "provenance"]
          },
          "traversability": {
            "type": "object",
